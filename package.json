{
  "name": "hrms-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready Single-Company HRMS (Human Resource Management System) Monorepo",
  "workspaces": [
    "packages/shared",
    "backend",
    "web",
    "mobile"
  ],
  "scripts": {
    "setup": "npm install --workspaces",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces --if-present",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:web": "npm run dev --workspace=web",
    "dev:mobile": "npm run start --workspace=mobile",
    "db:migrate": "npm run db:migrate --workspace=backend",
    "db:seed": "npm run db:seed --workspace=backend",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
