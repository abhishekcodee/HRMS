{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://hrms-backend-dlez.onrender.com/api/:match*"
    },
    {
      "source": "/socket.io/:match*",
      "destination": "https://hrms-backend-dlez.onrender.com/socket.io/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
