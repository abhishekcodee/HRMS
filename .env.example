# ==============================================================================
# HRMS Environment Configuration Example
# ==============================================================================

# Server Configuration
PORT=4000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Database Configuration (MySQL / XAMPP Localhost)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hrms_db
DB_DATABASE=hrms_db
DB_USER=root
DB_USERNAME=root
DB_PASSWORD=
DATABASE_URL=mysql://root:@localhost:3306/hrms_db
DB_SSL=false
DB_MAX_CONNECTIONS=20

# JWT & Authentication Configuration
JWT_SECRET=super-secret-jwt-key-replace-in-production-min-32-chars
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=super-secret-refresh-key-replace-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Logging Configuration
LOG_LEVEL=debug

# ZKTeco Integration Configuration
ZKTECO_DEVICE_IP=192.168.1.201
ZKTECO_DEVICE_PORT=4370
ZKTECO_SYNC_INTERVAL_MINUTES=15

# Redis / Queue Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# App Metadata
APP_NAME=HRMS
COMPANY_NAME="Enterprise HRMS Inc."
