# ==============================================================================
# HRMS Environment Configuration Example
# ==============================================================================

# Server Configuration
PORT=4000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Database Configuration (MySQL / XAMPP Localhost)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hrms_db
DB_DATABASE=hrms_db
DB_USER=root
DB_USERNAME=root
DB_PASSWORD=
DATABASE_URL=mysql://root:@localhost:3306/hrms_db
DB_SSL=false
DB_MAX_CONNECTIONS=20

# JWT & Authentication Configuration
JWT_SECRET=super-secret-jwt-key-replace-in-production-min-32-chars
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=super-secret-refresh-key-replace-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Logging Configuration
LOG_LEVEL=debug

# eSSL / ZKTeco ADMS (Cloud Server) integration
# The address shown in "Biometric Devices -> Device setup guide". Leave empty to auto-detect
# (on Render, RENDER_EXTERNAL_HOSTNAME + port 443 + HTTPS are used automatically).
ADMS_PUBLIC_HOST=
ADMS_PUBLIC_PORT=
ADMS_PUBLIC_HTTPS=
ZKTECO_DEVICE_IP=192.168.1.201
ZKTECO_DEVICE_PORT=4370

# E-mail (needed for payslip e-mails). Gmail: use an App Password, not your normal password.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="HR & Payroll"

# Payroll automation
# The server checks every 15 minutes whether it is salary day. On hosts that sleep when idle
# (Render free tier), also call GET /api/v1/payroll-cron?key=<PAYROLL_CRON_KEY> every 15-30 minutes
# from a free cron service. Use a random string of at least 16 characters.
PAYROLL_CRON_KEY=
# Set to "off" to disable the in-process scheduler (e.g. when only the cron URL should trigger it)
PAYROLL_SCHEDULER=

# Redis / Queue Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# App Metadata
APP_NAME=HRMS
COMPANY_NAME="Enterprise HRMS Inc."
